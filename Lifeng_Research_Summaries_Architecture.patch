new file mode 100644
index 0000000..7947803
--- /dev/null
+++ b/layouts/notes/list.html
@@ -0,0 +1,43 @@
+{{ define "main" }}
+<header class="page-hero">
+  <div class="container page-hero__inner">
+    {{ with .Params.eyebrow }}<p class="eyebrow">{{ . }}</p>{{ end }}
+    <h1>{{ .Title }}</h1>
+    {{ with .Description }}<p class="lede">{{ . }}</p>{{ end }}
+  </div>
+</header>
+<div class="container section-list">
+  {{ with .Content }}<div class="prose section-intro">{{ . }}</div>{{ end }}
+  {{ $allSummaries := .Pages }}
+  {{ $topics := slice
+    "Hydrology & Watershed Modeling"
+    "Urban Stormwater"
+    "Climate & Agricultural Systems"
+    "Environmental Assessment"
+  }}
+  <div class="summary-groups">
+    {{ range $topics }}
+      {{ $topic := . }}
+      {{ $summaries := where $allSummaries "Params.topic" $topic }}
+      {{ with $summaries }}
+      <section class="summary-group" aria-labelledby="{{ $topic | anchorize }}">
+        <div class="summary-group__heading">
+          <h2 id="{{ $topic | anchorize }}">{{ $topic }}</h2>
+          <span>{{ len . }} {{ cond (eq (len .) 1) "summary" "summaries" }}</span>
+        </div>
+        <div class="note-grid">
+          {{ range .ByWeight }}
+          <article class="note-card">
+            <p class="card-meta">{{ .Params.publication_year | default "Research summary" }}</p>
+            <h3><a href="{{ .RelPermalink }}">{{ .LinkTitle }}</a></h3>
+            <p>{{ .Description | default .Summary }}</p>
+            <a class="text-link" href="{{ .RelPermalink }}">Read summary <span aria-hidden="true">→</span></a>
+          </article>
+          {{ end }}
+        </div>
+      </section>
+      {{ end }}
+    {{ end }}
+  </div>
+</div>
+{{ end }}
