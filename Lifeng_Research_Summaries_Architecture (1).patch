+      <aside class="summary-resources" aria-label="Publication resources">
+        <p>Publication resources</p>
+        {{ partial "publication-links.html" (dict "title" $.Params.publication_title "hideSummary" true) }}
+      </aside>
+      {{ end }}
+    {{ end }}
     <div class="prose">{{ .Content }}</div>
-    <nav class="article-back" aria-label="Back to notes"><a href="{{ "notes/" | relURL }}">← All research notes</a></nav>
